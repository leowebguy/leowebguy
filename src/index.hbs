<!doctype html>
<html lang="en" data-bs-theme="dark">
{{> partials/head
    title='leowebguy'
    canonical='https://leowebguy.com/' }}
<style>
    img.svg {
        width: 24px;
        height: 24px;
    }
</style>
<body class="d-flex flex-column min-vh-100">
    <div class="container my-6">
        <div class="p-4 border rounded shadow-lg">
            <div class="row align-items-center">
                <div class="col-lg-4 offset-lg-1 mb-4 mb-lg-0 order-lg-2">
                    <img src="img/leo.jpg" alt="leowebguy" class="rounded img-fluid">
                </div>
                <div class="col-lg-7 order-lg-1">

                    <h4>Web Engineer, PHP & Craft CMS expert with 14+ yrs of experience working with clients ranging from small businesses to large corporations.</h4>

                    <div class="d-flex my-4"></div>

                    <div class="d-flex flex-wrap align-content-center gap-2">
                        <img alt="PHP" src="svg/php.svg" class="svg" title="PHP">
                        <img alt="Craft CMS" src="svg/craftcms.svg" class="svg" title="Craft CMS">
                        <img alt="Laravel" src="svg/laravel.svg" class="svg" title="Laravel">
                        <img alt="Yii" src="svg/yii.svg" class="svg" title="Yii">
                        <img alt="Symfony" src="svg/symfony.svg" class="svg" title="Symfony">
                        <img alt="Shopify" src="svg/shopify.svg" class="svg" title="Shopify">
                        <img alt="WordPress" src="svg/wp.svg" class="svg" title="WordPress">
                    </div>

                    <div class="d-flex my-2"></div>

                    <div class="d-flex flex-wrap align-content-center gap-2">
                        <img alt="Docker" src="svg/docker.svg" class="svg" title="Docker">
                        <img alt="Linux" src="svg/linux.svg" class="svg" title="Linux">
                        <img alt="Ubuntu" src="svg/ubuntu.svg" class="svg" title="Ubuntu">
                        <img alt="AWS" src="svg/aws.svg" class="svg" title="AWS">
                        <img alt="Cloudflare" src="svg/cloudflare.svg" class="svg" title="Cloudflare">
                        <img alt="Digital Ocean" src="svg/do.svg" class="svg" title="Digital Ocean">
                        <img alt="Google Cloud" src="svg/googlecloud.svg" class="svg" title="Google Cloud">
                        <img alt="Github" src="svg/github.svg" class="svg" title="Github">
                        <img alt="MySQL" src="svg/mysql.svg" class="svg" title="MySQL">
                        <img alt="PostgreSQL" src="svg/postgre.svg" class="svg" title="PostgreSQL">
                        <img alt="MariaDB" src="svg/mariadb.svg" class="svg" title="MariaDB">
                        <img alt="Redis" src="svg/redis.svg" class="svg" title="Redis">
                    </div>

                    <div class="d-flex my-2"></div>

                    <div class="d-flex flex-wrap align-content-center gap-2">
                        <img alt="NodeJS" src="svg/node.svg" class="svg" title="NodeJS">
                        <img alt="NPM" src="svg/npm.svg" class="svg" title="NPM">
                        <img alt="JavaScript" src="svg/js.svg" class="svg" title="JavaScript">
                        <img alt="NuxtJS" src="svg/nuxt.svg" class="svg" title="NuxtJS">
                        <img alt="VueJs" src="svg/vue.svg" class="svg" title="Vue">
                        <img alt="Veutify" src="svg/veutify.svg" class="svg" title="Veutify">
                        <img alt="ReactJs" src="svg/react.svg" class="svg" title="React">
                        <img alt="GraphQL" src="svg/graphql.svg" class="svg" title="GraphQL">
                        <img alt="AlpineJs" src="svg/alpine.svg" class="svg" title="Alpine">
                        <img alt="Webpack" src="svg/webpack.svg" class="svg" title="Webpack">
                        <img alt="Vite" src="svg/vite.svg" class="svg" title="Vite">
                        <img alt="Sass" src="svg/sass.svg" class="svg" title="Sass">
                        <img alt="Bootstrap" src="svg/bootstrap.svg" class="svg" title="Bootstrap">
                        <img alt="Tailwind" src="svg/tailwind.svg" class="svg" title="Tailwind">
                    </div>

                    <div class="d-flex my-3"></div>

                    <div class="d-flex flex-row gap-2">
                        <a href="//github.com/leowebguy" target="_blank" class="btn btn-outline-primary"><i
                            class="bi bi-github"></i></a>
                        <a href="//linkedin.com/in/leowebguy" target="_blank"
                           class="btn btn-outline-primary"><i class="bi bi-linkedin"></i></a>
                        <a href="//stackoverflow.com/users/3058927/leo-leoncio" target="_blank"
                           class="btn btn-outline-primary"><i class="bi bi-stack-overflow"></i></a>
                        <a href="javascript:void(0)" type="button" class="btn btn-secondary contact"><i
                            class="bi bi-envelope-at"></i></a>
                    </div>

                </div>
            </div>
        </div>
    </div>
    {{> partials/modal id='contact' }}
    <script src="{{{ vendorJS }}}"></script>
    <script src="{{{ appJS }}}"></script>
</body>
</html>
